{
  "name": "quintet",
  "version": "0.1.0",
  "private": true,
  "description": "One prompt, five coordinated builds: CSS, HTML, JavaScript, React and Python that describe the same animation.",
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "next build",
    "build:static": "node scripts/build-static.mjs",
    "start": "next start -p 3210",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sucrase": "^3.35.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
