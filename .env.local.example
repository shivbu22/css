# ---------------------------------------------------------------------------
# Server runtime (default). Generation runs in Next route handlers via Ollama.
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-coder
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=15m
GENERATION_TEMPERATURE=0.2
MAX_TARGET_TOKENS=2048
TARGET_TIMEOUT_MS=240000

# Set to 1 to serve canned generations instead of calling a model. Useful for
# UI work and for seeing the app before any model is pulled.
# QUINTET_FAKE=1

# Hard cap on requests per minute for the generate route.
GENERATE_RATE_LIMIT_PER_MIN=30

# ---------------------------------------------------------------------------
# Client runtime (browser-only static build: npm run build:static)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_RUNTIME=client
#
# Use Pyodide's own CDN path, NOT the npm mirror: the mirrored wheels fail
# subresource-integrity checks against Pyodide's lock file, so loadPackage
# silently installs nothing and matplotlib/numpy imports fail later.
# NEXT_PUBLIC_PYODIDE_URL=https://cdn.jsdelivr.net/pyodide/v314.0.7/full/pyodide.mjs
# NEXT_PUBLIC_WEBLLM_MODEL=Qwen2.5-Coder-1.5B-Instruct-q4f16_1-MLC
# NEXT_PUBLIC_WEBLLM_URL=https://esm.run/@mlc-ai/web-llm
# NEXT_PUBLIC_SUCRASE_URL=https://esm.run/sucrase
